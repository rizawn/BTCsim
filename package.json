{
  "name": "sha256-tycoon",
  "version": "0.0.0",
  "description": "SHA-256 Tycoon — Bitcoin mining tycoon game",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test",
    "ci": "npm run lint && npm run test && npm run build",
    "electron": "npm run build && electron .",
    "sim:demo": "npx tsx src/sim/demo.ts",
    "sim:balance": "npx tsx src/sim/balance.ts"
  },
  "keywords": [
    "bitcoin",
    "mining",
    "tycoon",
    "phaser",
    "game"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@fontsource/bitter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
